# Local development process settings. No secrets belong in this file.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
VITE_API_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./llc_assistant.sqlite3
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Phase 10 LLM boundary is disabled by default. Never commit a real API key.
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MAX_TOOL_ROUNDS=4
# Optional OpenAI-compatible endpoint override.
OPENAI_BASE_URL=
